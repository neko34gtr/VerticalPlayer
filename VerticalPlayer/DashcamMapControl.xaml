<UserControl x:Class="VerticalPlayer.Dashcam.DashcamMapControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="DashcamMapControl_Loaded">
    <!-- NuGetパッケージ Microsoft.Web.WebView2 の追加参照が必要（.csproj未確認のため
         プロジェクト側での追加をお願いします）。ランタイム自体はWindows10/11なら
         Edgeの一部として大抵プリインストール済みだが、無い環境では別途Evergreen
         Runtimeのインストールが必要。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPanel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="走行軌跡" Foreground="{StaticResource TextAccentCyan}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>

            <!-- 表示方向: 自動(進行方位から東西/南北を判定)/縦固定/横固定。既定は自動。
                 実際のレイアウト切替（Hud配置・地図領域の拡大等）はDashcamPlayerView側が
                 OrientationModeとルート方位から総合判定して行う。 -->
            <ComboBox x:Name="OrientationCombo" Grid.Column="1" Width="64" Margin="0,0,8,0" FontSize="10"
                      Style="{StaticResource ModernCombo}" SelectionChanged="OrientationCombo_SelectionChanged"
                      ToolTip="地図の縦長/横長表示（自動=進行方位から判定、手動=固定）">
                <ComboBoxItem Content="自動" Tag="Auto" IsSelected="True"/>
                <ComboBoxItem Content="縦" Tag="Vertical"/>
                <ComboBoxItem Content="横" Tag="Horizontal"/>
            </ComboBox>

            <Button x:Name="FitAllButton" Grid.Column="2" Content="全体表示" Style="{StaticResource SecondaryBtn}" FontSize="10"
                    Padding="6,2" Margin="0,0,8,0" Click="FitAllButton_Click" ToolTip="今表示している軌跡全体が入るようにズームし直す"/>
            <CheckBox x:Name="FollowCheck" Grid.Column="3" Content="追従" IsChecked="True" Style="{StaticResource ModernCheck}"
                      Foreground="{StaticResource TextPrimary}" FontSize="11"
                      Checked="FollowCheck_Changed" Unchecked="FollowCheck_Changed"/>
        </Grid>

        <Border Grid.Row="1" Margin="8,0,8,8" Background="Black" CornerRadius="4" ClipToBounds="True">
            <wv2:WebView2 x:Name="Map"/>
        </Border>
    </Grid>
</UserControl>
