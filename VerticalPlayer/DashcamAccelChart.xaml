<UserControl x:Class="VerticalPlayer.Dashcam.DashcamAccelChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="DashcamAccelChart_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 加速度の簡易ストリップチャート。0G基準線を中心に、直近数秒分の前後/左右/上下Gを
         3本の折れ線で表示する。速度は軸のスケールが全く異なるため右側に専用の縦軸を設け、
         左側はG軸(-3〜3)、右側はkm/h軸(0〜180)として表示する。 -->
    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
        <Grid Height="130">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="10,4" VerticalAlignment="Center">
                <TextBlock Text="加速度 (G) / 速度" Foreground="{StaticResource TextAccentCyan}" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Rectangle Width="10" Height="3" Fill="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text=" 前後  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#22C55E" VerticalAlignment="Center"/>
                    <TextBlock Text=" 左右  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#F87171" VerticalAlignment="Center"/>
                    <TextBlock Text=" 上下  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#E5E7EB" VerticalAlignment="Center"/>
                    <TextBlock Text=" 速度" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 左軸: G目盛り（-3G〜+3G、ScaleGと連動） -->
            <Canvas x:Name="GAxisCanvas" Grid.Column="1" Margin="0,4,0,4">
                <TextBlock x:Name="GLabel3" Text=" 3" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabel2" Text=" 2" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabel1" Text=" 1" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabel0" Text=" 0" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabelM1" Text="-1" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabelM2" Text="-2" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="GLabelM3" Text="-3" Foreground="{StaticResource TextMuted}" FontSize="8"/>
            </Canvas>

            <Canvas x:Name="ChartCanvas" Grid.Column="2" ClipToBounds="True" Margin="4,4,4,4">
                <Line x:Name="GridPlus3" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <Line x:Name="GridPlus2" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <Line x:Name="GridPlus1" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <Line x:Name="ZeroLine" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="2,2"/>
                <Line x:Name="GridMinus1" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <Line x:Name="GridMinus2" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <Line x:Name="GridMinus3" Stroke="{StaticResource Border}" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.6"/>
                <!-- 速度線はGPSロスト区間で分断するため、コードビハインドで動的にPolylineを
                     追加/削除する（ここでは固定の1本を宣言しない）。 -->
                <Polyline x:Name="LineY" Stroke="#3B82F6" StrokeThickness="1.3"/>
                <Polyline x:Name="LineX" Stroke="#22C55E" StrokeThickness="1.3"/>
                <Polyline x:Name="LineZ" Stroke="#F87171" StrokeThickness="1.3"/>
                <Line x:Name="Playhead" Stroke="{StaticResource TextAccentCyan}" StrokeThickness="1.5" Opacity="0.85"/>
            </Canvas>

            <!-- 右軸: 速度目盛り（0〜180km/h、MaxSpeedKmhと連動） -->
            <Canvas x:Name="SpeedAxisCanvas" Grid.Column="3" Margin="2,4,4,4">
                <TextBlock x:Name="SpeedLabel180" Text="180" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel150" Text="150" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel120" Text="120" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel90" Text="  90" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel60" Text="  60" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel30" Text="  30" Foreground="{StaticResource TextMuted}" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel0" Text="   0km/h" Foreground="{StaticResource TextMuted}" FontSize="8"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
