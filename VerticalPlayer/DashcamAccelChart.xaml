<UserControl x:Class="VerticalPlayer.Dashcam.DashcamAccelChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="DashcamAccelChart_SizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 加速度の簡易ストリップチャート。0G基準線を中心に、直近数秒分の前後/左右/上下Gを
         3本の折れ線で表示する。速度は軸のスケールが全く異なるため右側に専用の縦軸を設け、
         左側はG軸(-3〜3)、右側はkm/h軸(0〜180)として表示する。軸ラベルは右揃え（数値の
         位が揃って見えるように）・白文字、グリッド線(破線)は視認性のため明るめのグレーにしている。

         再生スライダー（旧SeekSlider相当）は波形プロットとは完全に独立した最上段の帯
         (SeekBarCanvas、Grid.Row="0")として分離してある。列構成(Auto/18/*/34)はRow0/Row1で
         共有しており、SeekBarCanvas(Row0,Col2)とChartCanvas(Row1,Col2)は常に同じ幅になる＝
         スライダーの左端〜右端はグラフのプロット開始〜終了位置と完全に一致する。マウスの
         クリック/ドラッグ判定もSeekBarCanvas側だけで受け付け、波形プロット(ChartCanvas)自体は
         クリックしても反応しない見るだけの領域にしている。 -->
    <Border Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
        <Grid Height="130">
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <!-- 再生スライダー専用の帯（独立・波形と重ならない） -->
                <RowDefinition Height="*"/>
                <!-- 波形プロット（G軸・速度軸・折れ線） -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="10,4" VerticalAlignment="Center">
                <TextBlock Text="加速度 (G) / 速度" Foreground="{StaticResource TextAccentCyan}" FontSize="10" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <Rectangle Width="10" Height="3" Fill="#3B82F6" VerticalAlignment="Center"/>
                    <TextBlock Text=" 前後  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#22C55E" VerticalAlignment="Center"/>
                    <TextBlock Text=" 左右  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#F87171" VerticalAlignment="Center"/>
                    <TextBlock Text=" 上下  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" Fill="#E5E7EB" VerticalAlignment="Center"/>
                    <TextBlock Text=" 速度  " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                    <Line X1="0" X2="10" Y1="0" Y2="0" Stroke="#E5E7EB" StrokeThickness="1.5" StrokeDashArray="3,2" VerticalAlignment="Center"/>
                    <TextBlock Text=" 推定" Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- 再生スライダー（トラック＋塗り＋丸ツマミ、ボリュームスライダーと同じ見た目）。
                 波形プロットとは独立した帯であり、シーク操作の受付もここだけで行う。 -->
            <Canvas x:Name="SeekBarCanvas" Grid.Row="0" Grid.Column="2" Background="Transparent"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="SeekBarCanvas_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="SeekBarCanvas_PreviewMouseLeftButtonUp"
                    MouseMove="SeekBarCanvas_MouseMove"
                    MouseLeave="SeekBarCanvas_MouseLeave">
                <Line x:Name="SeekTrackBg" Stroke="#334155" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Line x:Name="SeekTrackFill" Stroke="{StaticResource TextAccentCyan}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Ellipse x:Name="SeekThumb" Width="14" Height="14" Fill="White" Stroke="{StaticResource TextAccentCyan}" StrokeThickness="1.5" IsHitTestVisible="False"/>
            </Canvas>

            <!-- 左軸: G目盛り（-3G〜+3G、ScaleGと連動）。右揃え・白文字。 -->
            <Canvas x:Name="GAxisCanvas" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4">
                <TextBlock x:Name="GLabel3" Text="3" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabel2" Text="2" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabel1" Text="1" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabel0" Text="0" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabelM1" Text="-1" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabelM2" Text="-2" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="GLabelM3" Text="-3" Width="18" TextAlignment="Right" Foreground="White" FontSize="8"/>
            </Canvas>

            <!-- 波形プロット本体。見るだけの領域（クリック/ドラッグには反応しない）。
                 グリッド線(破線)は視認性のため明るめのグレー(#64748B)にしている。
                 Playheadは波形との対応を見るための薄い縦ガイド線として残す。 -->
            <Canvas x:Name="ChartCanvas" Grid.Row="1" Grid.Column="2" ClipToBounds="True" Margin="4,4,4,4" Background="Transparent">
                <Line x:Name="GridPlus3" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <Line x:Name="GridPlus2" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <Line x:Name="GridPlus1" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <Line x:Name="ZeroLine" Stroke="#94A3B8" StrokeThickness="1" StrokeDashArray="2,2" Opacity="0.9"/>
                <Line x:Name="GridMinus1" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <Line x:Name="GridMinus2" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <Line x:Name="GridMinus3" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="1,3" Opacity="0.8"/>
                <!-- 速度線はGPSロスト区間で分断するため、コードビハインドで動的にPolylineを
                     追加/削除する（ここでは固定の1本を宣言しない）。 -->
                <Polyline x:Name="LineY" Stroke="#3B82F6" StrokeThickness="1.3"/>
                <Polyline x:Name="LineX" Stroke="#22C55E" StrokeThickness="1.3"/>
                <Polyline x:Name="LineZ" Stroke="#F87171" StrokeThickness="1.3"/>
                <Line x:Name="Playhead" Stroke="{StaticResource TextAccentCyan}" StrokeThickness="1" Opacity="0.35"/>
            </Canvas>

            <!-- 右軸: 速度目盛り（0〜180km/h、MaxSpeedKmhと連動）。右揃え・白文字。
                 "0km/h"のみ文字が長いため列幅を34pxに拡げて右揃えでも収まるようにしている。 -->
            <Canvas x:Name="SpeedAxisCanvas" Grid.Row="1" Grid.Column="3" Margin="2,4,4,4">
                <TextBlock x:Name="SpeedLabel180" Text="180" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel150" Text="150" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel120" Text="120" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel90" Text="90" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel60" Text="60" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel30" Text="30" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
                <TextBlock x:Name="SpeedLabel0" Text="0km/h" Width="30" TextAlignment="Right" Foreground="White" FontSize="8"/>
            </Canvas>
        </Grid>
    </Border>
</UserControl>
