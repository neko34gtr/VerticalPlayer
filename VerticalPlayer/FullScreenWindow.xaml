<Window x:Class="VerticalPlayer.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Black"
        WindowState="Maximized"
        Topmost="True"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="OB" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- LibVLCSharp VideoView -->
        <vlc:VideoView x:Name="VideoView" Background="Black" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- OSD：マウス移動で表示、3秒で自動非表示 -->
        <Border x:Name="Osd" VerticalAlignment="Bottom" Visibility="Collapsed">
            <Border Margin="32,0,32,32" CornerRadius="14" Padding="16,12">
                <Border.Background>
                    <SolidColorBrush Color="#CC000000"/>
                </Border.Background>
                <StackPanel>
                    <!-- シーク行 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SeekBar" Grid.Column="0" VerticalAlignment="Center"
                                Minimum="0" Maximum="100"
                                PreviewMouseLeftButtonDown="Seek_MouseDown"
                                Thumb.DragStarted="Seek_DragStarted"
                                Thumb.DragCompleted="Seek_DragCompleted">
                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="5" CornerRadius="2.5" Background="#3B82F6"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="5" CornerRadius="2.5" Background="#334155"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Width="28" Height="28">
                                                            <Ellipse Fill="Transparent"/>
                                                            <Ellipse Width="14" Height="14" Fill="White"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                        <TextBlock x:Name="TimeText" Grid.Column="1"
                                   Foreground="White" FontFamily="Consolas" FontSize="12"
                                   Margin="14,0,0,0" VerticalAlignment="Center" Text="0:00 / 0:00"/>
                    </Grid>
                    <!-- ボタン行 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 左：音量 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OB}" Click="Mute_Click">
                                <Path Data="M4,7 H8 L13,3 V17 L8,13 H4 Z M15,7 Q18,10 15,13"
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <Slider x:Name="VolSlider" Width="80" Minimum="0" Maximum="1" Value="0.7"
                                    VerticalAlignment="Center" Margin="4,0" ValueChanged="Vol_Changed">
                                <Slider.Template>
                                    <ControlTemplate TargetType="Slider">
                                        <Track x:Name="PART_Track">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="Slider.DecreaseLarge">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" CornerRadius="2" Background="#3B82F6"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="Slider.IncreaseLarge">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Height="4" Background="#334155" CornerRadius="2"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid Width="22" Height="22">
                                                                <Ellipse Fill="Transparent"/>
                                                                <Ellipse Width="12" Height="12" Fill="White"
                                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </ControlTemplate>
                                </Slider.Template>
                            </Slider>
                        </StackPanel>
                        <!-- 中央 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource OB}" Click="PrevFile_Click" ToolTip="前のファイル">
                                <Path Data="M5,3 V17 M19,3 L7,10 L19,17 Z" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource OB}" Click="FrameBack_Click" ToolTip="コマ戻し">
                                <Path Data="M10,4 L4,10 L10,16 M16,4 L10,10 L16,16" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource OB}" Click="Rewind_Click" ToolTip="-10秒">
                                <Path Data="M14,6 L6,12 L14,18 Z M8,6 L8,18" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <Button Click="PlayPause_Click" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="48" Height="48" CornerRadius="24">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#6366F1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path x:Name="PlayIcon" Data="M7,5 L19,12 L7,19 Z"
                                      Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource OB}" Click="FastForward_Click" ToolTip="+10秒">
                                <Path Data="M10,6 L18,12 L10,18 Z M16,6 L16,18" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource OB}" Click="FrameStep_Click" ToolTip="コマ送り">
                                <Path Data="M6,4 L12,10 L6,16 M12,4 L18,10 L12,16" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource OB}" Click="NextFile_Click" ToolTip="次のファイル">
                                <Path Data="M19,3 V17 M5,3 L17,10 L5,17 Z" Stroke="White" StrokeThickness="1.5"
                                      Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                        <!-- 右：解除 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="SpeedLabel" Foreground="#94A3B8"
                                       FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource OB}" Click="Exit_Click" ToolTip="全画面解除 (Esc/F11)">
                                <Path Data="M8,3 H3 V8 M3,3 L9,9 M16,3 H21 V8 M21,3 L15,9 M8,21 H3 V16 M3,21 L9,15 M16,21 H21 V16 M21,21 L15,15"
                                      Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
