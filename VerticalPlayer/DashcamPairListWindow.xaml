<Window x:Class="VerticalPlayer.Dashcam.DashcamPairListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Front/Rear ペア一覧" Height="560" Width="720"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- DataGridの既定スタイルは白背景になるため、メインテーマの配色で上書きする -->
            <Style x:Key="ThemedColumnHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource BgPanel}"/>
                <Setter Property="Foreground" Value="{StaticResource TextAccentCyan}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>
            <Style x:Key="ThemedCell" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,5"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#1E3A5F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- SD_DBLIST.DB (DashcamPairDatabase)に保存されているFront→Rearの組み合わせを表示・編集する。
         保存はNo単位のUPDATEのみ（新規行の追加はここでは行わない＝スキャン時にのみ増える）。
         Rear列はコンボボックスで、現在のフォルダに存在するRearファイル名＋「(なし)」から選ぶ。
         標準のOSタイトルバーではなく、メインウィンドウと同じ自前タイトルバー(ドラッグ移動・
         最小化/閉じる)にしてアプリ全体の見た目と統一している。 -->
    <Border Background="{StaticResource BgDeep}" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- カスタムタイトルバー -->
            <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Front / Rear ペア一覧" Foreground="{StaticResource TextPrimary}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="—" Width="40" Style="{StaticResource IconBtn}" Click="Minimize_Click"/>
                        <Button Content="✕" Width="40" Style="{StaticResource IconBtn}" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 本体 -->
            <Grid Grid.Row="1" Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SD_DBLIST.DB に保存されているFront/Rearの組み合わせです。Rear列はプルダウンで手動変更できます。変更は「保存」を押すまで反映されません。"
                           Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                <DataGrid x:Name="Grid_Rows" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{StaticResource BgSurface}" Foreground="{StaticResource TextPrimary}"
                          RowBackground="{StaticResource BgPanel}" AlternatingRowBackground="{StaticResource BgCard}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource Border}"
                          HeadersVisibility="Column" RowHeaderWidth="0" BorderThickness="1"
                          BorderBrush="{StaticResource Border}"
                          ColumnHeaderStyle="{StaticResource ThemedColumnHeader}"
                          CellStyle="{StaticResource ThemedCell}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding No}" IsReadOnly="True" Width="50"/>
                        <DataGridTextColumn Header="Front" Binding="{Binding FrontFileName}" IsReadOnly="True" Width="*"/>
                        <DataGridComboBoxColumn x:Name="Col_Rear" Header="Rear" SelectedItemBinding="{Binding RearDisplay}" Width="*"/>
                        <DataGridTextColumn Header="更新日時(UTC)" Binding="{Binding UpdatedAt}" IsReadOnly="True" Width="170"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="保存" Width="90" Style="{StaticResource PrimaryBtn}" Click="SaveButton_Click" Margin="0,0,8,0"/>
                    <Button Content="閉じる" Width="90" Style="{StaticResource SecondaryBtn}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
