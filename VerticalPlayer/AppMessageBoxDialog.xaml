<Window x:Class="VerticalPlayer.AppMessageBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VerticalPlayer" Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Yu Gothic UI"
        Loaded="Window_Loaded">
    <Window.Resources>
        <!-- デフォルト（ダークモード）の色定義 -->
        <SolidColorBrush x:Key="WindowBgBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TextBrush" Color="White"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#BBBBBB"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="BtnHoverBrush" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#555555"/>

        <Style x:Key="DialogBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BtnHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="BorderBrush" Value="#005A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <!-- プライマリは常に白文字 -->
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource DialogBtn}">
            <Setter Property="Foreground" Value="#FF6B6B"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- アイコン＋メッセージ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconBorder" Grid.Column="0"
                    Width="32" Height="32" CornerRadius="16"
                    VerticalAlignment="Top" Margin="0,0,14,0">
                <TextBlock x:Name="TbIcon" Text="⚠"
                           FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TbTitle" FontSize="14" FontWeight="Bold"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TbMessage" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubTextBrush}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <!-- ボタン行 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnNo" Style="{StaticResource DialogBtn}"
                    Click="BtnNo_Click" Visibility="Collapsed">
                <TextBlock Text="いいえ"/>
            </Button>
            <Button x:Name="BtnYes" Style="{StaticResource PrimaryBtn}"
                    Click="BtnYes_Click" Visibility="Collapsed">
                <TextBlock Text="はい"/>
            </Button>
            <Button x:Name="BtnOk" Style="{StaticResource PrimaryBtn}"
                    Click="BtnOk_Click" Visibility="Collapsed">
                <TextBlock Text="OK"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>