<UserControl x:Class="VerticalPlayer.Dashcam.DashcamHudOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- ラベルは背景なし・数値のみ色違い背景カードで強調したレイアウト -->
    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
        <Grid Margin="10,6" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- センサー情報 見出し（左寄せ） -->
            <TextBlock Grid.Row="0" Text="センサー情報" Foreground="{StaticResource TextAccentCyan}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,8"/>

            <!-- 速度 (km/h) 行 -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding SpeedLabelText}" Foreground="{StaticResource TextAccentCyan}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <!-- 数値のみ背景カード -->
                <Border Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="4" Padding="8,2" MinWidth="45">
                    <TextBlock Text="{Binding SpeedText}" Foreground="{Binding SpeedBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 加速度(G) 行 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="加速度(G)" Foreground="{StaticResource TextAccentCyan}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 前後 -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="前後" Foreground="{StaticResource TextAccentCyan}" FontSize="9" VerticalAlignment="Center" Margin="0,2,4,2"/>
                    <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="3" Padding="6,1" Margin="0,1" HorizontalAlignment="Right" MinWidth="45">
                        <TextBlock Text="{Binding AccelYText}" Foreground="White" FontSize="9" HorizontalAlignment="Right"/>
                    </Border>

                    <!-- 左右 -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="左右" Foreground="{StaticResource TextAccentCyan}" FontSize="9" VerticalAlignment="Center" Margin="0,2,4,2"/>
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="3" Padding="6,1" Margin="0,1" HorizontalAlignment="Right" MinWidth="45">
                        <TextBlock Text="{Binding AccelXText}" Foreground="White" FontSize="9" HorizontalAlignment="Right"/>
                    </Border>

                    <!-- 上下 -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="上下" Foreground="{StaticResource TextAccentCyan}" FontSize="9" VerticalAlignment="Center" Margin="0,2,4,2"/>
                    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource BgCard}" CornerRadius="3" Padding="6,1" Margin="0,1" HorizontalAlignment="Right" MinWidth="45">
                        <TextBlock Text="{Binding AccelZText}" Foreground="White" FontSize="9" HorizontalAlignment="Right"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>