<UserControl x:Class="VerticalPlayer.Controls.SevenSegmentDigit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="40" Height="70"
             IsHitTestVisible="False">
    <!-- 基準サイズ 40x70。上から A(上) / F,B(左右上) / G(中) / E,C(左右下) / D(下)。Fill はコードビハインドで OnBrush / OffBrush を切り替える。 -->
