<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      MainWindow.xamlのWindow.Resourcesで定義されているカラートークン・共通スタイルの複製。
      DashcamPlayerView/DashcamHudOverlayはUserControlであり、StaticResourceの解決は
      「自分自身のXAMLが読み込まれる時点」でのリソーススコープ（自分のResources→
      マージ済み辞書→Application.Resources）でしか行われず、実行時にどのWindowへ
      追加されるかには依存しない。そのため、実行時にMainWindowの子として配置されても
      MainWindow.xaml側のWindow.Resourcesは参照できず、
      "'BgDeep' という名前のリソースが見つかりません" のようなXamlParseExceptionになる。
      これを避けるため、必要なキーをこのファイルに複製し、Dashcam側の各XAMLから
      MergedDictionariesで読み込む方式にしている。

      注意: MainWindow.xaml側の値を変更した場合、こちらも手動で同期が必要（現状は複製）。
      将来的にはApp.xamlのApplication.Resourcesへ一本化し、MainWindow.xaml側も
      そこからMergeする形にまとめるのが望ましい。
    -->

    <!-- ========== カラートークン ========== -->
    <SolidColorBrush x:Key="BgDeep"       Color="#080C14"/>
    <SolidColorBrush x:Key="BgSurface"    Color="#0F1623"/>
    <SolidColorBrush x:Key="BgPanel"      Color="#141C2E"/>
    <SolidColorBrush x:Key="BgCard"       Color="#1A2438"/>
    <SolidColorBrush x:Key="BgHover"      Color="#1E2B42"/>
    <SolidColorBrush x:Key="AccentBlue"   Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentCyan"   Color="#06B6D4"/>
    <SolidColorBrush x:Key="AccentViolet" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="TextPrimary"  Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextMuted"    Color="#64748B"/>
    <!-- ドラレコモードの見出し系テキスト専用の強調色（ドライブ/表示倍率/センサー情報/
         車速/加速度/前後/左右/上下/走行軌跡など）。TextMutedのままだとダーク背景で
         薄グレーが見づらいとのご指摘により追加。オフホワイト(TextPrimary)の値表示部は
         そのまま維持する。 -->
    <SolidColorBrush x:Key="TextAccentCyan" Color="#38BDF8"/>
    <SolidColorBrush x:Key="TextFaint"    Color="#334155"/>
    <SolidColorBrush x:Key="Border"       Color="#1E2D45"/>

    <!-- ========== アイコンボタン ========== -->
    <Style x:Key="IconBtn" TargetType="Button">
        <Setter Property="Background"   Value="Transparent"/>
        <Setter Property="Foreground"   Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#263347"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== プライマリボタン ========== -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="10,6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3B82F6" Offset="0"/>
                                <GradientStop Color="#6366F1" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== セカンダリボタン ========== -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
        <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="#1A2438" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== 危険ボタン ========== -->
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
        <Setter Property="Foreground" Value="#F87171"/>
        <Setter Property="BorderBrush" Value="#3B1A1A"/>
    </Style>

    <!-- ========== スライダー共通 ========== -->
    <Style x:Key="ModernSlider" TargetType="Slider">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                                        <GradientStop Color="#6366F1" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="#1E2D45" CornerRadius="2"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 透明な大きいヒット領域 + 見た目の小さい玉 -->
                                            <Grid Width="28" Height="28">
                                                <Ellipse Fill="Transparent" Width="28" Height="28"/>
                                                <Ellipse Width="14" Height="14" Fill="White"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== トグルスイッチ風チェックボックス ========== -->
    <Style x:Key="ModernCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel LastChildFill="True">
                        <Border x:Name="Track" DockPanel.Dock="Left" Width="34" Height="18"
                                CornerRadius="9" Background="#334155" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <Border x:Name="Knob" Width="14" Height="14" CornerRadius="7"
                                    Background="White" HorizontalAlignment="Left" Margin="2,0,2,0"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#6366F1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ========== コンボボックス ========== -->
    <!-- 既定のComboBoxはWindows既定配色（白背景）のままレンダリングされる部分があり、
         ダークテーマの文字色と組み合わさると「白背景に白文字で見えない」問題になる
         （実機で確認）。ポップアップ含め全面的に再テンプレート化して回避する。 -->
    <Style x:Key="ModernComboItem" TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernCombo" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BgCard}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleBtn"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      ClickMode="Press" Focusable="False">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid Margin="{TemplateBinding Padding}" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            <Path Grid.Column="1" Data="M0,0 L6,6 L12,0 Z" Fill="{StaticResource TextMuted}"
                                  Width="12" Height="6" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="240">
                                <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== リスト（Front/Rear動画リスト等） ========== -->
    <!-- 既定のListBox/ListBoxItemはIsEnabled=False時にシステム配色（明るいグレー/白）へ
         切り替わるトリガーを内部に持っているため、Front/Rearリストの見た目が別テーマ側に
         引っ張られてしまう（実機で確認：無効時のRearListが白背景になる）。
         完全に独自テンプレート化し、無効時は不透明度を落とすだけにする。 -->
    <Style x:Key="ModernListItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernListItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- ========== ドラレコ動画リストの項目テンプレート（中サイズサムネイル＋ラベル） ========== -->
    <!-- Thumbnailは生成完了までnullのため、その間は背景色だけのプレースホルダーになる。
         DashcamMediaGroup.ThumbnailはINotifyPropertyChanged経由でバインディングに反映される。 -->
    <!-- カード形式(サムネ|短縮ファイル名)で横並びにし、1件あたりの縦の高さを抑えることで
         リストに一度に表示できる件数を増やす（従来は縦積みで1件あたり約140pxもあり、
         3件程度しか見えていなかった）。サムネイルも半分程度のサイズに縮小。 -->
    <DataTemplate x:Key="DashcamListItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="4,2">
            <Border Width="96" Height="54" Background="#0A0F1A" CornerRadius="3" ClipToBounds="True">
                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding ShortLabel}" Foreground="{StaticResource TextPrimary}" FontSize="10"
                       Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
