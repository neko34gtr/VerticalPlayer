<UserControl x:Class="VerticalPlayer.Dashcam.DashcamPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:media="clr-namespace:VerticalPlayer.Media"
             xmlns:dash="clr-namespace:VerticalPlayer.Dashcam"
             xmlns:ctl="clr-namespace:VerticalPlayer.Controls"
             Loaded="DashcamPlayerView_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DashcamTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- 配色・ボタンスタイル(IconBtn/SecondaryBtn/PrimaryBtn/ModernSlider/ModernCheck/ModernCombo/ModernList)は
         DashcamTheme.xaml（MainWindow.xamlの配色トークン・共通スタイルの複製）を
         UserControl.ResourcesにMergedDictionariesで取り込んで使っている。 -->
    <Grid Background="{StaticResource BgDeep}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 録画フォルダ種別・ドライブ選択・オプション -->
            <RowDefinition Height="*"/>
            <!-- リスト(ホバーで展開) + 映像 + 日時/緯度経度 + 走行軌跡マップ -->
            <RowDefinition Height="Auto"/>
            <!-- 再生コントロール -->
            <RowDefinition Height="Auto"/>
            <!-- 加速度ストリップチャート（右隣に常時センサー情報(速度/加速度3軸)を固定表示） -->
        </Grid.RowDefinitions>

        <!-- ========== 録画フォルダ種別・ドライブ選択・オプションバー ========== -->
        <!-- 「読み込む」ボタンは廃止。イベント種別/ドライブいずれかの選択が変わったら自動で
             読み込み直す（選択のたびに毎回ボタンを押す導線が無駄との指摘のため）。 -->
        <Border x:Name="ToolbarBar" Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,6">
                <TextBlock Text="フォルダ" Foreground="{StaticResource TextAccentCyan}" VerticalAlignment="Center" Margin="4,0,6,0"/>
                <ComboBox x:Name="EventFolderCombo" Width="100" Margin="0,0,4,0" Style="{StaticResource ModernCombo}"
                          SelectionChanged="EventFolderCombo_SelectionChanged">
                    <ComboBoxItem Content="NORMAL" Tag="Normal" IsSelected="True"/>
                    <ComboBoxItem Content="MANUAL" Tag="Manual"/>
                    <ComboBoxItem Content="EVENT" Tag="Event"/>
                    <ComboBoxItem Content="PARKING" Tag="Parking"/>
                </ComboBox>

                <TextBlock Text="ドライブ" Foreground="{StaticResource TextAccentCyan}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="DriveCombo" Width="200" Margin="0,0,4,0" Style="{StaticResource ModernCombo}"
                          DisplayMemberPath="DisplayName" SelectionChanged="DriveCombo_SelectionChanged"/>
                <Button x:Name="RefreshDrivesButton" Content="⟳" Width="28" Style="{StaticResource IconBtn}"
                        Click="RefreshDrivesButton_Click" ToolTip="ドライブ一覧を更新" Margin="0,0,16,0"/>
                <Button x:Name="PairListButton" Content="ペア一覧" Style="{StaticResource SecondaryBtn}"
                        Click="PairListButton_Click" ToolTip="SD_DBLIST.DBのFront/Rear組み合わせを確認・編集" Margin="0,0,16,0"/>

                <CheckBox x:Name="RearLinkedCheck" Content="リア追従" IsChecked="True" Style="{StaticResource ModernCheck}"
                          Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                          Checked="RearLinkedCheck_Changed" Unchecked="RearLinkedCheck_Changed" Margin="0,0,16,0"/>

                <TextBlock Text="フロント倍率" Foreground="{StaticResource TextAccentCyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="ZoomCombo" Width="90" SelectionChanged="ZoomCombo_SelectionChanged" Margin="0,0,16,0"
                          Style="{StaticResource ModernCombo}">
                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                    <ComboBoxItem Content="オリジナル" Tag="1"/>
                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                    <ComboBoxItem Content="2x" Tag="2" IsSelected="True"/>
                    <ComboBoxItem Content="3x" Tag="3"/>
                    <ComboBoxItem Content="4x" Tag="4"/>
                </ComboBox>

                <!-- リア倍率: リア表示スイッチがONの間だけ表示（コードビハインドのUpdateRearPipVisibilityで切替）。
                     Tagはリア映像の等倍(オリジナル)を1.0とした縮小倍率。最大=オリジナル(映像エリアに収まる範囲)、
                     最小0.115=従来のPiP既定サイズ(220x124)。中間値は暫定 -->
                <StackPanel x:Name="RearZoomPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="リア倍率" Foreground="{StaticResource TextAccentCyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="RearZoomCombo" Width="90" SelectionChanged="RearZoomCombo_SelectionChanged" Margin="0,0,16,0"
                              Style="{StaticResource ModernCombo}">
                        <ComboBoxItem Content="0.11x" Tag="0.115" IsSelected="True"/>
                        <ComboBoxItem Content="0.25x" Tag="0.25"/>
                        <ComboBoxItem Content="0.5x" Tag="0.5"/>
                        <ComboBoxItem Content="オリジナル" Tag="1"/>
                    </ComboBox>
                </StackPanel>

                <!-- 車速OSD（映像右上に走行速度を大きく表示）。AppSettings.EnableOSDで永続化 -->
                <CheckBox x:Name="SpeedOsdCheck" Content="車速OSD" IsChecked="True" Style="{StaticResource ModernCheck}"
                          Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                          Checked="SpeedOsdCheck_Changed" Unchecked="SpeedOsdCheck_Changed" Margin="0,0,16,0"
                          ToolTip="映像の右上に走行速度を大きく表示"/>

                <CheckBox x:Name="DnnEnabledCheck" Content="AI推論(超解像)" Style="{StaticResource ModernCheck}"
                          Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                          Checked="DnnEnabledCheck_Changed" Unchecked="DnnEnabledCheck_Changed"/>
            </StackPanel>
        </Border>

        <!-- ========== リスト(ホバー展開) + 映像 + 日時/緯度経度 + 走行軌跡マップ ========== -->
        <!-- センサー情報のうち「速度・加速度3軸」は縦/横どちらの地図モードでも常にチャート横
             （Grid.Row="3"）に固定表示する。一方「日時」「緯度/経度」は従来通り地図の上に
             独立して表示する（チャート横のHudには詰め込まない）。地図の向き(縦/横/自動)は
             右サイドバーの列幅にのみ影響し、この日時/緯度経度パネルの位置には影響しない。 -->
        <Grid x:Name="MainRowGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSidebarColumnDef" Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左サイドバー: 通常は幅16pxの細いバーだけ表示し、マウスオーバーで展開する
                 （常時220px確保すると画面を圧迫するため。展開中は映像エリアが一時的に
                 狭くなるが、離れれば自動で戻る）。 -->
            <Border x:Name="LeftSidebarHost" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="16" Panel.ZIndex="100"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    ClipToBounds="True"
                    MouseEnter="LeftSidebarHost_MouseEnter" MouseLeave="LeftSidebarHost_MouseLeave">
                <Grid>
                    <Border x:Name="CollapsedHint" Background="{StaticResource TextAccentCyan}" Width="3"
                            HorizontalAlignment="Left" Opacity="0.55"/>

                    <!-- 折りたたみ中もVisibility="Collapsed"にはしない（レイアウトパス自体が
                         スキップされ、ListBox内部のScrollViewerテンプレートが一度も生成されず
                         「一度もホバーしていないと自動スクロールが効かない」不具合の原因に
                         なっていたため）。表示上はホストのWidth=16px＋ClipToBounds=Trueで
                         十分隠れるので、中身は常にVisible/レイアウト済みのまま持っておく。 -->
                    <Grid x:Name="SidebarContent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="フロント" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="12,10,12,6"/>
                        <ListBox x:Name="FrontList" Grid.Row="1" Style="{StaticResource ModernList}"
                                 ItemTemplate="{StaticResource DashcamListItemTemplate}"
                                 SelectionChanged="FrontList_SelectionChanged"/>

                        <TextBlock Grid.Row="2" Text="リア（手動選択可・選ぶと追従は自動解除）" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" Margin="12,10,12,6"/>
                        <ListBox x:Name="RearList" Grid.Row="3" Style="{StaticResource ModernList}"
                                 ItemTemplate="{StaticResource DashcamListItemTemplate}"
                                 SelectionChanged="RearList_SelectionChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- 映像エリア -->
            <Grid x:Name="VideoArea" Grid.Column="1" Background="Black" SizeChanged="VideoArea_SizeChanged">
                <!-- フロント（メイン） -->
                <media:FfmpegMediaElement x:Name="PlayerFront"
                              UseGpuPresenter="True"
                              MediaOpened="PlayerFront_MediaOpened"
                              MediaEnded="PlayerFront_MediaEnded"
                              MediaFailed="PlayerFront_MediaFailed"/>

                <!-- リア（PiP）: ドラッグで自由配置・右下グリップで自由リサイズできるようCanvasに乗せる -->
                <Canvas x:Name="RearPipCanvas" SizeChanged="RearPipCanvas_SizeChanged">
                    <Border x:Name="RearPipBorder"
                Width="220" Height="124"
                BorderBrush="{StaticResource Border}" BorderThickness="1"
                Background="Black"
                Visibility="Collapsed"
                Cursor="SizeAll"
                MouseLeftButtonDown="RearPipBorder_MouseLeftButtonDown"
                MouseMove="RearPipBorder_MouseMove"
                MouseLeftButtonUp="RearPipBorder_MouseLeftButtonUp">
                        <Grid>
                            <media:FfmpegMediaElement x:Name="PlayerRear"
                                          UseGpuPresenter="True"
                                          Volume="0"
                                          IsHitTestVisible="False"
                                          MediaOpened="PlayerRear_MediaOpened"
                                          MediaEnded="PlayerRear_MediaEnded"
                                          MediaFailed="PlayerRear_MediaFailed"/>
                            <!-- 右下の小さな三角グリップだけリサイズ専用（ドラッグ移動より手前で受け止める） -->
                            <Rectangle x:Name="RearPipResizeGrip" Width="14" Height="14"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Fill="{StaticResource TextAccentCyan}" Opacity="0.7"
                           Cursor="SizeNWSE"
                           MouseLeftButtonDown="RearPipResizeGrip_MouseLeftButtonDown"
                           MouseMove="RearPipResizeGrip_MouseMove"
                           MouseLeftButtonUp="RearPipResizeGrip_MouseLeftButtonUp"/>
                        </Grid>
                    </Border>
                </Canvas>

                <!-- 車速OSD: 7セグメントLED風（ベクター描画、外部フォント不要）。高さは映像エリアの高さに追従
                     （VideoArea_SizeChanged → UpdateSpeedOsdSize）、幅は縦横比を保ってViewboxが決める。
                     クリックはすべて下のPiP/映像へ素通しする -->
                <ctl:SevenSegmentSpeedOsd x:Name="SpeedOsd" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,10,20,0" Height="60"
                                          IsHitTestVisible="False" Visibility="Collapsed">
                    <ctl:SevenSegmentSpeedOsd.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.95"/>
                    </ctl:SevenSegmentSpeedOsd.Effect>
                </ctl:SevenSegmentSpeedOsd>

                <!-- 地図情報通知: 現在地名・次のSA/PA・接近中/通過中トンネル。
                     IsHitTestVisible=Falseなので下の映像/PiPへクリックは素通しする。 -->
                <dash:MapInfoOverlayControl x:Name="MapInfo"/>
            </Grid>

            <!-- 右サイドバー: 上段=日時・緯度経度（常時固定表示）、下段=走行軌跡マップ。
                 列幅(RightSidebarColumnDef)だけを地図の向き(縦/横/自動)に応じて
                 ApplyMapOrientationが調整する（狭め=縦長ルート向き／広め=横長ルート向き）。 -->
            <Grid x:Name="RightSidebarHost" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,8">
                    <StackPanel>
                        <TextBlock x:Name="GeoDateTimeText" Text="----/--/-- --:--:--" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock FontSize="11" Margin="0,5,0,0">
                            <Run Text="経度 " Foreground="{StaticResource TextMuted}"/><Run x:Name="GeoLngText" Text="---" Foreground="White"/><Run Text="   緯度 " Foreground="{StaticResource TextMuted}"/><Run x:Name="GeoLatText" Text="---" Foreground="White"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <dash:DashcamMapControl x:Name="MapView" Grid.Row="1"/>
            </Grid>
        </Grid>

        <!-- ========== コントロールバー ========== -->
        <!-- 旧シークバーはAccelChart側へ統合したため、ここには代わりにデコード/画質処理/fpsの
             状態表示を並べる（要望「シークバーがあった箇所にデコード:HW等の表示を移動」）。 -->
        <Border x:Name="ControlBar" Grid.Row="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="8" ToolTipService.InitialShowDelay="300">
                    <!-- 操作アイコンは文字(▶■📷)ではなく Segoe Fluent Icons / Segoe MDL2 Assets のグリフを使う。
                         4K等の高解像度でも輪郭がはっきりし、再生(▶)と一時停止(||)、停止(■)、カメラを取り違えない。
                         各ボタンにはTips(ツールチップ)を付けている。再生/一時停止はコードビハインド
                         (SetPlayPauseIcon)で状態に応じてアイコンとTipsを切り替える -->
                    <Button x:Name="PlayPauseButton" Content="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                            Width="44" Height="38" Style="{StaticResource IconBtn}" Click="PlayPauseButton_Click" Margin="0,0,4,0"
                            ToolTip="再生"/>
                    <Button x:Name="StopButton" Content="&#xE71A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                            Width="44" Height="38" Style="{StaticResource IconBtn}" Click="StopButton_Click" Margin="0,0,10,0"
                            ToolTip="停止（映像を閉じます。再生ボタンで先頭から再生し直します）"/>
                    <Button x:Name="PrevSceneButton" Content="◀◀ 前のシーン" Style="{StaticResource SecondaryBtn}" Click="PrevSceneButton_Click" Margin="0,0,6,0"
                            ToolTip="Frontリストの前のグループへ戻る"/>
                    <Button x:Name="NextSceneButton" Content="次のシーン ▶▶" Style="{StaticResource SecondaryBtn}" Click="NextSceneButton_Click" Margin="0,0,10,0"
                            ToolTip="Frontリストの次のグループへ進む"/>
                    <Button x:Name="ScreenshotButton" Content="&#xE722;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                            Width="44" Height="38" Style="{StaticResource IconBtn}" Click="ScreenshotButton_Click" Margin="0,0,10,0"
                            ToolTip="現在のフロント映像を静止画で保存（カメラ）"/>
                    <CheckBox x:Name="RearVisibleCheck" Content="リア表示" Style="{StaticResource ModernCheck}"
                              Foreground="{StaticResource TextPrimary}"
                              Checked="RearVisibleCheck_Changed" Unchecked="RearVisibleCheck_Changed"
                              VerticalAlignment="Center" Margin="6,0,16,0"/>

                    <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="13"/>
                    <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}" Width="70" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" Value="1" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="DecodeModeText" Text="デコード: -" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="実際に使用されているデコードモード（HW=D3D11VA / SW）"/>
                    <TextBlock x:Name="VideoCodecLabel" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,6,0"
                               ToolTip="映像コーデック（MediaInfo）"/>
                    <TextBlock x:Name="AudioCodecLabel" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,4,0"
                               ToolTip="音声コーデック（MediaInfo）"/>
                    <TextBlock x:Name="AudioChannelLabel" Text="" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="音声チャンネル（MediaInfo）"/>
                    <TextBlock x:Name="DeintStatusText" Text="De-int: OFF" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="デインターレース"/>
                    <TextBlock x:Name="NdrStatusText" Text="NDR: ON" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="ノイズリダクション"/>
                    <TextBlock x:Name="DcrStatusText" Text="DCR: ON" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,14,0"
                               ToolTip="ダイナミックコントラスト"/>
                    <TextBlock x:Name="FpsText" Text="-- fps" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                </StackPanel>

                <TextBlock x:Name="PositionText" Grid.Column="2" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="00:00:00 / 00:00:00"/>
            </Grid>
        </Border>

        <!-- AccelChart自体がシーク操作を兼ねる（最上段の独立した帯でクリック即シーク・
             ドラッグでプレビュー・ホバーで時刻ポップアップ）。センサー情報(速度・加速度3軸)は
             常にこの右隣に固定表示し、高さもチャートと同じ130に揃えている。日時・緯度経度は
             ここには置かず、上の地図パネル側に表示する（詰め込みすぎて速度表示が途切れていた
             不具合への対応）。 -->
        <Grid x:Name="ChartStrip" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="145"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>
            <dash:DashcamAccelChart x:Name="AccelChart" Grid.Column="0"/>
            <Border Grid.Column="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1,1,0,0">
                <dash:DashcamHudOverlay x:Name="Hud"/>
            </Border>
        </Grid>

        <Popup x:Name="SeekPreviewPopup" PlacementTarget="{Binding ElementName=AccelChart}"
               Placement="Top" AllowsTransparency="True" IsOpen="False" IsHitTestVisible="False">
            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="4" Padding="6,3">
                <TextBlock x:Name="SeekPreviewText" Foreground="{StaticResource TextPrimary}" FontSize="11"/>
            </Border>
        </Popup>

        <!-- サムネイル生成専用の非表示プレイヤー。画面外（Canvas.Left/Top=-2000）に配置することで
             通常のスクリーンショット機能と全く同じ描画経路（RenderTargetBitmap）を使えるようにする
             （Visibility=Hiddenだと内部的にOnRenderが呼ばれずキャプチャが空になる懸念があるため、
             見た目上は画面外に追いやるだけでVisible/Opacity=1のまま維持している）。 -->
        <Canvas ClipToBounds="False" IsHitTestVisible="False">
            <media:FfmpegMediaElement x:Name="ThumbCapturePlayer" Canvas.Left="-2000" Canvas.Top="-2000"
                                      Width="320" Height="180" UseGpuPresenter="False"/>
        </Canvas>
    </Grid>
</UserControl>
