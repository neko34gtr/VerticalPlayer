<Window x:Class="VerticalPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:VerticalPlayer.Media"
        Title="Vertical Player Pro"
        Height="860" Width="460"
        MinHeight="400" MinWidth="320"
        Background="#080C14"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- ========== カラートークン ========== -->
        <SolidColorBrush x:Key="BgDeep"       Color="#080C14"/>
        <SolidColorBrush x:Key="BgSurface"    Color="#0F1623"/>
        <SolidColorBrush x:Key="BgPanel"      Color="#141C2E"/>
        <SolidColorBrush x:Key="BgCard"       Color="#1A2438"/>
        <SolidColorBrush x:Key="BgHover"      Color="#1E2B42"/>
        <SolidColorBrush x:Key="AccentBlue"   Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentCyan"   Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentViolet" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#F1F5F9"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#64748B"/>
        <SolidColorBrush x:Key="TextFaint"    Color="#334155"/>
        <SolidColorBrush x:Key="Border"       Color="#1E2D45"/>

        <!-- ========== アイコンボタン ========== -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#263347"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== プライマリボタン ========== -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,6">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== セカンダリボタン ========== -->
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#1A2438" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 危険ボタン ========== -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource SecondaryBtn}">
            <Setter Property="Foreground" Value="#F87171"/>
            <Setter Property="BorderBrush" Value="#3B1A1A"/>
        </Style>

        <!-- ========== スライダー共通 ========== -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="#1E2D45" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- 透明な大きいヒット領域 + 見た目の小さい玉 -->
                                                <Grid Width="28" Height="28">
                                                    <Ellipse Fill="Transparent" Width="28" Height="28"/>
                                                    <Ellipse Width="14" Height="14" Fill="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#3B82F6" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== OSD用シークスライダー ========== -->
        <Style x:Key="OsdSeekSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                                            <GradientStop Color="#6366F1" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="#334155" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="32" Height="32">
                                                    <Ellipse Fill="Transparent"/>
                                                    <Ellipse Width="16" Height="16" Fill="White"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#3B82F6" BlurRadius="10" ShadowDepth="0" Opacity="0.9"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== OSDアイコンボタン（白系） ========== -->
        <Style x:Key="OsdIconBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== スクロールバー非表示 ========== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent" CornerRadius="2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#334155" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== RadioButton ========== -->
        <Style x:Key="ModernRadio" TargetType="RadioButton">
            <Setter Property="Foreground"   Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#1A2438" BorderBrush="{StaticResource Border}"
                                BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,2">
                            <DockPanel>
                                <Ellipse x:Name="Dot" Width="14" Height="14" DockPanel.Dock="Left" Margin="0,0,8,0"
                                         Stroke="#334155" StrokeThickness="2" Fill="Transparent"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="#3B82F6"/>
                                <Setter TargetName="Dot" Property="Stroke" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="Bd" Property="Background" Value="#0F1E38"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== CheckBox ========== -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel>
                            <Border x:Name="Box" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0"
                                    CornerRadius="4" BorderBrush="#334155" BorderThickness="1.5" Background="Transparent">
                                <TextBlock x:Name="Mark" Text="✓" Foreground="White" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0"/>
                                            <GradientStop Color="#6366F1" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Box"  Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="Mark" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== TabControl ========== -->
        <Style x:Key="PanelTab" TargetType="TabControl">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- タブヘッダー -->
                            <Border Grid.Row="0" Background="#0F1623" CornerRadius="10,10,0,0" Padding="4">
                                <TabPanel IsItemsHost="True" HorizontalAlignment="Stretch"/>
                            </Border>
                            <!-- コンテンツ -->
                            <Border Grid.Row="1" Background="#141C2E" CornerRadius="0,0,10,10" Padding="12">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelTabItem" TargetType="TabItem">
            <Setter Property="Foreground"      Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" CornerRadius="7" Padding="10,6" Margin="2">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A2438"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== TextBox ========== -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#0F1623"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Padding"         Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== セパレーター ========== -->
        <Style x:Key="Separator" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="#1E2D45"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>
    </Window.Resources>

    <!-- ========== ウィンドウシェル ========== -->
    <Border Background="{StaticResource BgDeep}" CornerRadius="14"
            BorderBrush="#1E2D45" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="0" Opacity="0.7"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <!-- タイトルバー -->
                <RowDefinition Height="*"/>
                <!-- ビデオエリア -->
                <RowDefinition Height="Auto"/>
                <!-- コントロール -->
            </Grid.RowDefinitions>

            <!-- ========== タイトルバー ========== -->
            <Border x:Name="TitleBar" Grid.Row="0" Background="#0A1020" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：メニューボタン + タイトル -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MenuButton" Style="{StaticResource IconBtn}"
                                Click="Menu_Click" ToolTip="設定">
                            <Grid Width="16" Height="16">
                                <Path Data="M0,3 H16 M0,8 H16 M0,13 H16"
                                      Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button>
                        <!-- ロゴドット -->
                        <Ellipse Width="6" Height="6" Margin="4,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="VP" Foreground="{StaticResource TextPrimary}"
                                   FontSize="12" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                    </StackPanel>

                    <!-- 中央：ファイル名 -->
                    <TextBlock x:Name="FileNameText" Grid.Column="1"
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>

                    <!-- 右：ウィンドウ操作 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="FullScreen_Click" ToolTip="全画面 (F11)" Padding="8">
                            <Path x:Name="FullScreenIcon"
                                  Data="M3,3 H8 M3,3 V8 M21,3 H16 M21,3 V8 M3,21 H8 M3,21 V16 M21,21 H16 M21,21 V16"
                                  Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="Minimize_Click" ToolTip="最小化" Padding="8">
                            <Path Data="M0,5 H10" Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="MaxRestore_Click" ToolTip="最大化/元に戻す" Padding="8">
                            <Path Data="M0,0 H10 V10 H0 Z" Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.5" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="Close_Click" ToolTip="閉じる" Padding="8">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#F87171"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== ビデオエリア ========== -->
            <Border Grid.Row="1" Background="Black" ClipToBounds="True">
                <Grid x:Name="VideoArea"
                      MouseWheel="Player_MouseWheel"
                      AllowDrop="True"
                      Drop="Window_Drop"
                      DragOver="Window_DragOver">

                    <!-- ドロップヒント -->
                    <Border x:Name="DropHint" Background="Transparent" CornerRadius="0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="72" Height="72" CornerRadius="20" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0F1E38" Offset="0"/>
                                        <GradientStop Color="#1A1040" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M36,20 L36,44 M24,36 L36,48 L48,36 M20,52 H52"
                                      Stroke="#3B82F6" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="動画ファイルをドロップ" Foreground="{StaticResource TextMuted}"
                                       FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Text="mp4 · mov · avi · mkv" Foreground="{StaticResource TextFaint}"
                                       FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- ドラッグオーバー時のグロー枠 -->
                    <Border x:Name="DragGlow" Visibility="Collapsed"
                            BorderBrush="#3B82F6" BorderThickness="2" CornerRadius="0"
                            Background="#0A1828" Opacity="0.6"/>

                    <!-- ========== OSDパネル（全画面時のマウスオーバーで表示） ========== -->
                    <Border x:Name="OsdPanel"
                            VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                            Visibility="Collapsed" Panel.ZIndex="10"
                            MouseEnter="Osd_MouseEnter" MouseLeave="Osd_MouseLeave">
                        <Border Margin="24,0,24,20" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#CC000000" Offset="0"/>
                                    <GradientStop Color="#EE000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <BlurEffect KernelType="Gaussian" Radius="0"/>
                            </Border.Effect>
                            <StackPanel Margin="16,12,16,14">
                                <!-- 1段目：シークバー + 時間 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OsdSeekBar" Grid.Column="0"
                                            Style="{StaticResource OsdSeekSlider}"
                                            Minimum="0" VerticalAlignment="Center"
                                            Thumb.DragStarted="OsdSeekBar_DragStarted"
                                            Thumb.DragCompleted="OsdSeekBar_DragCompleted"
                                            PreviewMouseLeftButtonDown="OsdSeekBar_PreviewMouseLeftButtonDown"/>
                                    <TextBlock x:Name="OsdTimeDisplay" Grid.Column="1"
                                               Foreground="White" Text="0:00 / 0:00"
                                               FontSize="11" FontFamily="Consolas"
                                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- 2段目：操作ボタン -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 左：音量 -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource OsdIconBtn}" Click="Mute_Click" ToolTip="ミュート">
                                            <Path Data="M4,7 H8 L13,3 V17 L8,13 H4 Z M15,7 Q18,10 15,13 M17,5 Q22,10 17,15"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                                        </Button>
                                        <Slider x:Name="OsdVolumeSlider" Style="{StaticResource ModernSlider}"
                                                Width="80" Minimum="0" Maximum="1" Value="0.7"
                                                VerticalAlignment="Center" Margin="4,0,0,0"
                                                ValueChanged="OsdVolume_Changed"/>
                                    </StackPanel>
                                    <!-- 中央：再生ボタン群 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource OsdIconBtn}" Click="Rewind_Click" ToolTip="-10秒">
                                            <Path Data="M14,6 L6,12 L14,18 Z M8,6 L8,18"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                                        </Button>
                                        <!-- OSD再生/停止ボタン -->
                                        <Button Click="PlayPause_Click" ToolTip="再生/一時停止" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Width="44" Height="44" CornerRadius="22">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#3B82F6" Offset="0"/>
                                                                <GradientStop Color="#6366F1" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Path x:Name="OsdPlayIcon" Data="M7,5 L19,12 L7,19 Z"
                                                  Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource OsdIconBtn}" Click="FastForward_Click" ToolTip="+10秒">
                                            <Path Data="M10,6 L18,12 L10,18 Z M16,6 L16,18"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                                        </Button>
                                    </StackPanel>
                                    <!-- 右：全画面解除 -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource OsdIconBtn}" Click="FullScreen_Click" ToolTip="全画面解除 (F11)">
                                            <Path Data="M8,3 H3 V8 M3,3 L9,9 M16,3 H21 V8 M21,3 L15,9 M8,21 H3 V16 M3,21 L9,15 M16,21 H21 V16 M21,21 L15,15"
                                                  Stroke="White" StrokeThickness="1.5" Fill="Transparent"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 映像表示（FFmpegコアエンジン / WriteableBitmap描画、Airspace非依存）
                         黒帯なしフィット・固定ズーム・強制アスペクト比はFfmpegMediaElement内部で計算するため
                         Viewboxは使わず、コンテナいっぱいに配置する -->
                    <media:FfmpegMediaElement x:Name="Player"
                                  LoadedBehavior="Manual"
                                  RenderOptions.BitmapScalingMode="HighQuality"
                                  SnapsToDevicePixels="True"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  MediaOpened="Player_MediaOpened"
                                  MediaEnded="Player_MediaEnded"
                                  MediaFailed="Player_MediaFailed"
                                  RenderTransformOrigin="0.5,0.5">
                        <media:FfmpegMediaElement.RenderTransform>
                            <ScaleTransform x:Name="PlayerFlipTransform" ScaleX="1" ScaleY="1"/>
                        </media:FfmpegMediaElement.RenderTransform>
                        <media:FfmpegMediaElement.LayoutTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="PlayerRotation"/>
                                <ScaleTransform  x:Name="PlayerScale" ScaleX="1" ScaleY="1"/>
                            </TransformGroup>
                        </media:FfmpegMediaElement.LayoutTransform>
                    </media:FfmpegMediaElement>
                </Grid>
            </Border>

            <!-- ========== コントロールパネル ========== -->
            <Border x:Name="ControlPanel" Grid.Row="2" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
                <StackPanel Margin="16,12,16,14">

                    <!-- シークバー + 時間 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Slider x:Name="SeekBar" Style="{StaticResource ModernSlider}"
                                    Minimum="0" VerticalAlignment="Center"
                                    Thumb.DragStarted="SeekBar_DragStarted"
                                    Thumb.DragCompleted="SeekBar_DragCompleted"
                                    PreviewMouseLeftButtonDown="SeekBar_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="SeekBar_PreviewMouseLeftButtonUp"/>
                            <Canvas x:Name="ChapterTicksCanvas" Height="3" VerticalAlignment="Bottom"
                                    Margin="6,0" IsHitTestVisible="False"/>
                            <Popup x:Name="SeekPreviewPopup" Placement="Relative" PlacementTarget="{Binding ElementName=SeekBar}"
                                   AllowsTransparency="True" IsHitTestVisible="False" VerticalOffset="-34">
                                <Border Background="#E6202020" CornerRadius="4" Padding="6,3"
                                        BorderBrush="{StaticResource TextMuted}" BorderThickness="1">
                                    <TextBlock x:Name="SeekPreviewText" Foreground="White" FontSize="11" FontFamily="Consolas"/>
                                </Border>
                            </Popup>    
                        </Grid>
                        <TextBlock x:Name="TimeDisplay" Grid.Column="1"
                                   Foreground="{StaticResource TextMuted}" Text="0:00 / 0:00"
                                   FontSize="10" FontFamily="Consolas" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- メインコントロール行 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：音量 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MuteButton" Style="{StaticResource IconBtn}"
                                    Click="Mute_Click" Padding="6" ToolTip="ミュート">
                                <Path x:Name="VolumeIcon"
                                      Data="M4,7 H8 L13,3 V17 L8,13 H4 Z M15,7 Q18,10 15,13 M17,5 Q22,10 17,15"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20"/>
                            </Button>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource ModernSlider}"
                                    Width="80" Minimum="0" Maximum="1" Value="0.7"
                                    VerticalAlignment="Center" Margin="4,0,0,0"
                                    ValueChanged="Volume_Changed"/>
                        </StackPanel>

                        <!-- 中央：再生コントロール -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- 前ファイル -->
                            <Button Style="{StaticResource IconBtn}" Click="PrevFile_Click" ToolTip="前のファイル" Padding="6">
                                <Path Data="M5,3 V17 M19,3 L7,10 L19,17 Z"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <!-- コマ戻し -->
                            <Button Style="{StaticResource IconBtn}" Click="FrameBack_Click" ToolTip="コマ戻し (Shift+←)" Padding="6">
                                <Path Data="M10,4 L4,10 L10,16 M16,4 L10,10 L16,16"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Click="Rewind_Click" ToolTip="-10秒" Padding="8">
                                <Path Data="M14,6 L6,12 L14,18 Z M8,6 L8,18"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <!-- 再生/一時停止 -->
                            <Button x:Name="PlayPauseButton" Click="PlayPause_Click" ToolTip="再生/一時停止" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="44" Height="44" CornerRadius="22">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#3B82F6" Offset="0"/>
                                                    <GradientStop Color="#6366F1" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Path x:Name="PlayIcon" Data="M7,5 L19,12 L7,19 Z"
                                      Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Click="FastForward_Click" ToolTip="+10秒" Padding="8">
                                <Path Data="M10,6 L18,12 L10,18 Z M16,6 L16,18"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <!-- コマ送り -->
                            <Button Style="{StaticResource IconBtn}" Click="FrameStep_Click" ToolTip="コマ送り (Shift+→)" Padding="6">
                                <Path Data="M6,4 L12,10 L6,16 M12,4 L18,10 L12,16"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                            <!-- 次ファイル -->
                            <Button Style="{StaticResource IconBtn}" Click="NextFile_Click" ToolTip="次のファイル" Padding="6">
                                <Path Data="M19,3 V17 M5,3 L17,10 L5,17 Z"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>

                        <!-- 右：追加機能 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Click="OpenFile_Click"
                                    ToolTip="ファイルを開く" Padding="8">
                                <Path Data="M2,4 H10 L12,6 H20 V18 H2 Z"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Click="ZoomReset_Click"
                                    ToolTip="ズームリセット" Padding="8">
                                <Path Data="M3,10 L10,3 L17,10 M10,3 V17 M3,20 H17"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ループ / 状態インジケーター -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="LoopCheck" Grid.Column="0" Content="ループ"
                                  Style="{StaticResource ModernCheck}" FontSize="10"
                                  Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2"
                                   Foreground="{StaticResource TextFaint}" FontSize="10"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- コマ送りコントロール行 -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconBtn}" Click="FrameBack_Click"
                                    ToolTip="コマ戻し" Padding="5">
                                <Path Data="M10,4 L4,10 L10,16 M16,4 L10,10 L16,16"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource IconBtn}" Click="FrameStep_Click"
                                    ToolTip="コマ送り" Padding="5">
                                <Path Data="M6,4 L12,10 L6,16 M12,4 L18,10 L12,16"
                                      Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Fill="Transparent"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                            </Button>
                            <Button x:Name="AutoFrameBtn" Style="{StaticResource IconBtn}"
                                    Click="AutoFrame_Click" ToolTip="自動コマ送り（スロー再生）" Padding="5">
                                <TextBlock x:Name="AutoFrameLabel" Text="AUTO"
                                           Foreground="{StaticResource TextFaint}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Button>
                            <Button x:Name="HwStatusBtn" Style="{StaticResource IconBtn}"
                                    Click="HwStatus_Click" ToolTip="クリックでハードウェア/ソフトウェアデコードを切替"
                                    Padding="5" Margin="4,0,0,0">
                                <TextBlock x:Name="HwStatusLabel" Text="H/W"
                                           Foreground="{StaticResource TextFaint}"
                                           FontSize="9" FontWeight="Bold"/>
                            </Button>
                            <!-- PotPlayer風コーデック表示（映像コーデック / 音声コーデック / チャンネル数） -->
                            <TextBlock x:Name="VideoCodecLabel" Text=""
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBlock x:Name="AudioCodecLabel" Text=""
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                            <TextBlock x:Name="AudioChannelLabel" Text=""
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="9" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>
                        <!-- fps選択 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="fps:" Foreground="{StaticResource TextFaint}"
                                       FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="FrameRateCombo" FontSize="10" Width="52"
                                      SelectionChanged="FrameRate_Changed">
                                <ComboBoxItem Content="1"  Tag="1"/>
                                <ComboBoxItem Content="2"  Tag="2"/>
                                <ComboBoxItem Content="5"  Tag="5"/>
                                <ComboBoxItem Content="10" Tag="10" IsSelected="True"/>
                                <ComboBoxItem Content="15" Tag="15"/>
                                <ComboBoxItem Content="24" Tag="24"/>
                                <ComboBoxItem Content="30" Tag="30"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========== サイドパネル（スライドイン） ========== -->
            <Border x:Name="SidePanel" Grid.Row="0" Grid.RowSpan="3"
                    Background="#0D1525" Width="260"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Visibility="Collapsed" Panel.ZIndex="20"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" Direction="0" ShadowDepth="8" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- パネルヘッダー -->
                    <Border Grid.Row="0" Background="#080C14"
                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <DockPanel Margin="14,0">
                            <TextBlock Text="設定" Foreground="{StaticResource TextPrimary}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}"
                                    Click="Menu_Click" Padding="6" ToolTip="閉じる">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{StaticResource TextMuted}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="10" Height="10"/>
                            </Button>
                        </DockPanel>
                    </Border>

                    <!-- タブコンテンツ -->
                    <TabControl Grid.Row="1" Style="{StaticResource PanelTab}">
                        <TabItem Header="表示" Style="{StaticResource PanelTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- 表示モード -->
                                    <TextBlock Text="表示モード" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"
                                              />
                                    <RadioButton x:Name="NormalMode" GroupName="ViewMode"
                                                 Content="通常モード" Style="{StaticResource ModernRadio}"
                                                 IsChecked="True" Checked="Mode_Checked"/>
                                    <RadioButton x:Name="ForceVerticalMode" GroupName="ViewMode"
                                                 Content="強制縦型モード" Style="{StaticResource ModernRadio}"
                                                 Checked="Mode_Checked"/>

                                    <TextBlock Text="表示倍率" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="ScaleModeCombo" Margin="0,0,0,6"
                                              SelectionChanged="ScaleMode_Changed" SelectedIndex="0">
                                        <ComboBoxItem Content="オート（アスペクト比維持・黒帯最小）" Tag="Auto"/>
                                        <ComboBoxItem Content="サイズ x1（等倍）" Tag="Zoom1x"/>
                                        <ComboBoxItem Content="サイズ x2" Tag="Zoom2x"/>
                                        <ComboBoxItem Content="サイズ x2.5" Tag="Zoom2_5x"/>
                                        <ComboBoxItem Content="サイズ x3" Tag="Zoom3x"/>
                                        <ComboBoxItem Content="サイズ x4" Tag="Zoom4x"/>
                                    </ComboBox>

                                    <TextBlock Text="アスペクト比（オート時のみ）" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,4,0,4"/>
                                    <ComboBox x:Name="AspectModeCombo" Margin="0,0,0,6"
                                              SelectionChanged="AspectMode_Changed" SelectedIndex="0">
                                        <ComboBoxItem Content="動画本来の比率を維持" Tag="Native"/>
                                        <ComboBoxItem Content="自由（比率無視で伸縮）" Tag="Free"/>
                                        <ComboBoxItem Content="強制 16:9" Tag="Force16x9"/>
                                        <ComboBoxItem Content="強制 4:3" Tag="Force4x3"/>
                                        <ComboBoxItem Content="強制 9:16" Tag="Force9x16"/>
                                    </ComboBox>

                                    <CheckBox x:Name="DeinterlaceCheck" Content="デインターレース（簡易ブレンド方式）"
                                              Style="{StaticResource ModernCheck}" Margin="0,4"
                                              Checked="Deinterlace_Changed" Unchecked="Deinterlace_Changed"/>

                                    <CheckBox x:Name="DenoiseCheck" Content="ノイズリダクション（hqdn3d）"
                                              Style="{StaticResource ModernCheck}" Margin="0,4"
                                              Checked="Denoise_Changed" Unchecked="Denoise_Changed"/>

                                    <CheckBox x:Name="DynamicContrastCheck" Content="ダイナミックコントラスト（簡易オートレベル・GPU）"
                                              Style="{StaticResource ModernCheck}" Margin="0,4"
                                              Checked="DynamicContrast_Changed" Unchecked="DynamicContrast_Changed"/>

                                    <TextBlock Text="超解像（Lanczos + アンシャープ・GPU）" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="SuperResolutionCombo" Margin="0,0,0,6"
                                              SelectionChanged="SuperResolution_Changed" SelectedIndex="0">
                                        <ComboBoxItem Content="なし" Tag="1.0"/>
                                        <ComboBoxItem Content="1.5倍" Tag="1.5"/>
                                        <ComboBoxItem Content="2.0倍" Tag="2.0"/>
                                    </ComboBox>

                                    <TextBlock Text="比較ビュー（TrueTheater風）" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                    <ComboBox x:Name="CompareModeCombo" Margin="0,0,0,6"
                                              SelectionChanged="CompareMode_Changed" SelectedIndex="0">
                                        <ComboBoxItem Content="通常" Tag="0"/>
                                        <ComboBoxItem Content="1枚分割（ワイプ）" Tag="1"/>
                                        <ComboBoxItem Content="2枚分割（フル画像）" Tag="2"/>
                                    </ComboBox>

                                    <Border Style="{StaticResource Separator}"/>

                                    <!-- ハードウェア設定 -->
                                    <TextBlock Text="ハードウェア" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"
                                              />
                                    <CheckBox x:Name="HwAccelCheck" Content="ハードウェアアクセラレーション"
                                              Style="{StaticResource ModernCheck}" Margin="0,4"
                                              Checked="HwAccel_Changed" Unchecked="HwAccel_Changed"/>
                                    <TextBlock x:Name="DecodeModeText" Text="デコード: -"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="16" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="AlwaysOnTopCheck" Content="常に最前面"
                                              Style="{StaticResource ModernCheck}" Margin="0,4"
                                              Checked="AlwaysOnTop_Changed" Unchecked="AlwaysOnTop_Changed"/>
                                    <CheckBox x:Name="AutoPlayNextCheck" Content="再生終了時に次のファイルを自動再生"
                                              Style="{StaticResource ModernCheck}" Margin="0,4" IsChecked="True"
                                              Checked="AutoPlayNext_Changed" Unchecked="AutoPlayNext_Changed"/>

                                    <Border Style="{StaticResource Separator}"/>

                                    <!-- 再生速度 -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="再生速度" Foreground="{StaticResource TextMuted}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right"
                                                   Foreground="{StaticResource AccentBlue}"
                                                   FontSize="14" FontWeight="Bold" FontFamily="Consolas" Text="1.0×"/>
                                    </DockPanel>
                                    <Slider x:Name="SpeedSlider" Style="{StaticResource ModernSlider}"
                                            Minimum="0.1" Maximum="4.0" Value="1.0"
                                            IsSnapToTickEnabled="True" TickFrequency="0.1"
                                            ValueChanged="Speed_Changed" Margin="0,4"/>

                                    <Border Style="{StaticResource Separator}"/>
                                    <Button Content="ウィンドウを画面中央へ" Style="{StaticResource SecondaryBtn}"
                                            Click="CenterWindow_Click" Margin="0,4"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="エフェクト" Style="{StaticResource PanelTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- スライダー群 -->
                                    <StackPanel x:Name="EffectSliders">
                                        <!-- コントラスト -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="コントラスト" Foreground="{StaticResource TextMuted}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="ContrastLabel" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       FontSize="10" FontFamily="Consolas" Text="0.0"/>
                                        </DockPanel>
                                        <Slider x:Name="ContrastSlider" Style="{StaticResource ModernSlider}"
                                                Minimum="-1" Maximum="1" Value="0"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ValueChanged="Effect_Changed" Margin="0,0,0,10"/>

                                        <!-- 彩度 -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="彩度" Foreground="{StaticResource TextMuted}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SaturationLabel" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       FontSize="10" FontFamily="Consolas" Text="0.0"/>
                                        </DockPanel>
                                        <Slider x:Name="SaturationSlider" Style="{StaticResource ModernSlider}"
                                                Minimum="-1" Maximum="1" Value="0"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ValueChanged="Effect_Changed" Margin="0,0,0,10"/>

                                        <!-- ガンマ -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="ガンマ" Foreground="{StaticResource TextMuted}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="GammaLabel" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       FontSize="10" FontFamily="Consolas" Text="0.0"/>
                                        </DockPanel>
                                        <Slider x:Name="GammaSlider" Style="{StaticResource ModernSlider}"
                                                Minimum="-1" Maximum="1" Value="0"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ValueChanged="Effect_Changed" Margin="0,0,0,10"/>

                                        <!-- シャープネス（超解像のアンシャープマスク強度、GPU専用） -->
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="シャープネス（超解像用）" Foreground="{StaticResource TextMuted}"
                                                       FontSize="10" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="SharpnessLabel" DockPanel.Dock="Right"
                                                       Foreground="{StaticResource AccentCyan}"
                                                       FontSize="10" FontFamily="Consolas" Text="0.5"/>
                                        </DockPanel>
                                        <Slider x:Name="SharpnessSlider" Style="{StaticResource ModernSlider}"
                                                Minimum="0" Maximum="1.5" Value="0.5"
                                                IsSnapToTickEnabled="True" TickFrequency="0.1"
                                                ValueChanged="Sharpness_Changed" Margin="0,0,0,10"/>

                                        <CheckBox x:Name="ColorMatrixCheck" Content="BT.601→BT.709 色空間補正"
                                                  Style="{StaticResource ModernCheck}" Margin="0,0,0,10"
                                                  Checked="ColorMatrix_Changed" Unchecked="ColorMatrix_Changed"/>
                                    </StackPanel>

                                    <Button Content="エフェクトをリセット" Style="{StaticResource DangerBtn}"
                                            Click="ResetEffects_Click" Margin="0,4"/>

                                    <Border Style="{StaticResource Separator}"/>

                                    <!-- プリセット管理 -->
                                    <TextBlock Text="プリセット" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"
                                              />

                                    <!-- プリセット名入力 -->
                                    <TextBox x:Name="PresetNameBox" Style="{StaticResource ModernTextBox}"
                                             Text="プリセット名" Margin="0,0,0,6"/>

                                    <Button Content="現在値をプリセット保存" Style="{StaticResource PrimaryBtn}"
                                            Click="SavePreset_Click" Margin="0,0,0,8"/>

                                    <!-- プリセット一覧 -->
                                    <ItemsControl x:Name="PresetList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1A2438" CornerRadius="8"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                        Margin="0,3" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="適用"
                                                                Style="{StaticResource PrimaryBtn}"
                                                                Padding="6,4" FontSize="10"
                                                                Tag="{Binding}"
                                                                Click="ApplyPreset_Click" Margin="4,0,0,0"/>
                                                        <Button Grid.Column="2" Content="✕"
                                                                Style="{StaticResource DangerBtn}"
                                                                Padding="6,4" FontSize="10"
                                                                Tag="{Binding}"
                                                                Click="DeletePreset_Click" Margin="4,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="情報" Style="{StaticResource PanelTabItem}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="InfoPanel">
                                    <TextBlock Text="動画情報" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,10"
                                              />
                                    <StackPanel x:Name="VideoInfoStack"/>

                                    <Border Style="{StaticResource Separator}"/>

                                    <TextBlock Text="操作ガイド" Foreground="{StaticResource TextMuted}"
                                               FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                    <StackPanel>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="── 再生 ──" Margin="0,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="Space — 再生 / 一時停止" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="← → — 10秒シーク" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="Shift+← → — コマ戻し / コマ送り" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="Shift+↑ ↓ — 再生速度 ±0.1×" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="── 音量 ──" Margin="0,6,0,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="↑ ↓ — 音量 ±5%" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="M — ミュート切替" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="── 表示 ──" Margin="0,6,0,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="F11 / Alt+Enter — 全画面" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="Esc — 全画面解除" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="🖱 ホイール — ズーム" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="── ファイル ──" Margin="0,6,0,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="🖱 D&amp;D — ファイルを開く" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="⏮ ⏭ ボタン — 前後ファイル" Margin="8,2"/>
                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="10" Text="AUTO — スロー再生モード" Margin="8,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- サイドパネルオーバーレイ（クリックで閉じる） -->
            <Border x:Name="PanelOverlay" Grid.Row="0" Grid.RowSpan="3"
                    Background="Transparent" Visibility="Collapsed" Panel.ZIndex="19"
                    MouseLeftButtonDown="PanelOverlay_Click"/>
        </Grid>
    </Border>
</Window>
